<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 本机回环（127.0.0.1）socket 同样需要 INTERNET 权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 内核保活：前台服务 + 通知（Android 13+ 通知需授权，未授权时服务仍可运行） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RuntimeConsole">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 应用内详情页：加载内核控制台，不导出、不占桌面入口 -->
        <activity
            android:name=".KernelWebViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name" />

        <!-- 内核保活：只在前台服务里维持进程优先级，不承载业务 -->
        <service
            android:name=".KernelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local kernel runtimes kept alive for the developer console" />
        </service>
    </application>

</manifest>
